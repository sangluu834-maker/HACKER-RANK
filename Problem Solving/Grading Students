import sys

def gradingStudents(grades):
    danh_sach_diem_moi = []
    
    for diem in grades:
        
        if diem >= 38 and diem % 5 >= 3:
            
            diem_moi = diem + (5 - (diem % 5))
            danh_sach_diem_moi.append(diem_moi)
        else:
            
            danh_sach_diem_moi.append(diem)
            
    return danh_sach_diem_moi

